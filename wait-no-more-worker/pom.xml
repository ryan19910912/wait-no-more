  <artifactId>wait-no-more-worker</artifactId>

  <dependencies>
    <dependency>
      <groupId>com.waitnomore</groupId>
      <artifactId>wait-no-more-common</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
